{
  "browser": {
    "preferred": "edge",
    "port": 9222,
    "headless": false,
    "profileDir": "~/.agent-web-ai/profiles",
    "chromePath": null,
    "startupTimeoutMs": 45000,
    "keepAlive": true
  },
  "defaults": {
    "provider": "duckai",
    "timeoutMs": 120000,
    "stableMs": 3000,
    "pollMs": 500,
    "maxAnswerChars": 200000,
    "newChat": true
  },
  "providers": {
    "duckai": {
      "enabled": true,
      "displayName": "Duck.ai",
      "url": "https://duck.ai/",
      "requiresLogin": false,
      "note": "Default. No account needed, fastest in testing (~9s)."
    },
    "qwen": {
      "enabled": true,
      "displayName": "Qwen Chat",
      "url": "https://chat.qwen.ai/",
      "requiresLogin": false,
      "note": "Guest mode verified; signing in raises rate limits."
    },
    "deepseek": {
      "enabled": true,
      "displayName": "DeepSeek",
      "url": "https://chat.deepseek.com/",
      "requiresLogin": true
    },
    "chatgpt": {
      "enabled": true,
      "displayName": "ChatGPT",
      "url": "https://chatgpt.com/",
      "requiresLogin": true
    },
    "grok": {
      "enabled": true,
      "displayName": "Grok",
      "url": "https://grok.com/",
      "requiresLogin": true
    },
    "gemini": {
      "enabled": false,
      "displayName": "Google Gemini",
      "url": "https://gemini.google.com/app",
      "requiresLogin": true,
      "note": "Disabled by user preference."
    }
  },
  "logging": {
    "level": "info"
  }
}
